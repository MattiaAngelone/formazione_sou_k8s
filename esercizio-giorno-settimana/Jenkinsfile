pipeline {
    agent { label 'agent1' }

    stages {
        stage('Build') {
            steps {
                script {
                    def giorno = new Date()[Calendar.DAY_OF_WEEK]

                    if (giorno >= Calendar.MONDAY && giorno <= Calendar.FRIDAY) {
                        echo "Giorno feriale (${giorno}): eseguo la build"
                        sh 'echo "build simulata"'
                    } else {
                        echo "WARNING: weekend (${giorno}), build non eseguita"
                    }
                }
            }
        }
    }
}
